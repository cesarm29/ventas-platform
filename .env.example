# ========================================
# Variables de entorno para Railway + Neon
# ========================================
# Copia este archivo como .env y completa los valores

# Neon PostgreSQL (obtener de neon.tech > Dashboard > Connection Details)
DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/ventas_db?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=tu_password_de_neon

# JWT Secret (genera uno unico)
JWT_SECRET=TuClaveSecretaParaJWT2026Minimo32BytesLargos!!

# Backend port (Railway asigna automaticamente)
PORT=8080

# Frontend (actualizar en Vercel)
# API_URL=https://tu-backend-en-railway.up.railway.app/api
